{
  "rewrites": [
    {
      "source": "/api_proxy",
      "destination": "/api/proxy"
    },
    {
      "source": "/api_stream/(.*)",
      "destination": "/api/stream"
    },
    {
      "source": "/api_hlsr/(.*)",
      "destination": "/api/hlsr"
    },
    {
      "source": "/api_raw_proxy",
      "destination": "/api/raw_proxy"
    },
    {
      "source": "/api_subtitles",
      "destination": "/api/subtitles"
    }
  ]
}
